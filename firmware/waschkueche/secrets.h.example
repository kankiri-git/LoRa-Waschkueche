// Vorlage: nach secrets.h kopieren und ausfuellen (oder skripte/waschkueche-secrets.sh, das erzeugt die
// Passwoerter und den LoRa-Schluessel zufaellig). secrets.h nie veroeffentlichen (steht in .gitignore).
// Beide Geraete werden mit DERSELBEN secrets.h gebaut (gemeinsamer LoRa-Schluessel), aber jede Rolle
// uebernimmt nur ihren Teil ins Image (skripte/waschkueche-flashen.sh prueft das):
//   wasc (Waschkueche): LORA_KEY_HEX, AP_SSID, AP_PASS, OTA_PASS_WASC
//   wohn (Wohnung):     LORA_KEY_HEX, WIFI_SSID, WIFI_PASS, OTA_PASS, MQTT_*
#pragma once
#define WIFI_SSID     "MeinHeimWLAN"     // Heim-WLAN (nur Gateway)
#define WIFI_PASS     "…"
#define OTA_PASS      "…"     // Update des Gateways uebers Heim-WLAN
#define OTA_PASS_WASC "…"     // Update des Senders unter http://192.168.4.1/update (Benutzer admin), eigenes Passwort
#define AP_SSID       "…"     // eigenes WLAN des Senders nur fuer die Shellys; am besten ein Name, der nicht verraet,
                              // worum es geht (jeder in der Waschkueche sieht ihn)
#define AP_PASS       "…"     // Passwort dieses WLANs, mind. 8 Zeichen
#define LORA_KEY_HEX  "…"     // 32 Hex-Zeichen (AES-128), z. B. openssl rand -hex 16
// MQTT ist optional; ohne diese Zeilen laeuft das Gateway nur mit Statusseite.
// Mit dem Server aus server/: Host = Adresse des Servers, Benutzer waschkueche,
// Passwort = MQTT_PASS_WASCHKUECHE aus server/.env (legt server/einrichten.sh an).
#define MQTT_HOST     "192.168.178.10"  // Beispiel
#define MQTT_PORT     1883
#define MQTT_USER     "waschkueche"
#define MQTT_PASS     "…"
