# Vorlage; ./einrichten.sh legt .env mit zufaelligen Werten an. .env nie veroeffentlichen.
TZ=Europe/Berlin
INFLUX_PASS=...
INFLUX_TOKEN=...
GRAFANA_PASS=...
MQTT_PASS_WASCHKUECHE=...      # fuer das Gateway: in firmware/waschkueche/secrets.h als MQTT_PASS eintragen
MQTT_PASS_TELEGRAF=...
MQTT_PASS_FERTIGMELDUNG=...
# Optional: Push-Nachricht aufs Handy ueber ntfy (App "ntfy", Thema abonnieren). Ein langes, zufaelliges Thema
# waehlen, auf ntfy.sh kann jeder mitlesen, der den Namen kennt.
NTFY_URL=
NTFY_TOKEN=
